APP_NAME="Thu Chi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Use https://... once SSL is enabled for the domain
APP_URL=http://ketoandichvu123.byethost7.com

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# From VistaPanel > MySQL Databases (names start with b7_43546388_)
DB_CONNECTION=mysql
DB_HOST=sqlXXX.byethost7.com
DB_PORT=3306
DB_DATABASE=b7_43546388_thuchi
DB_USERNAME=b7_43546388
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
# false while the site runs on http; set true after enabling SSL
SESSION_SECURE_COOKIE=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Free hosting usually cannot send mail: keep "log" (password reset emails go to storage/logs)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ketoandichvu123.byethost7.com"
MAIL_FROM_NAME="${APP_NAME}"
