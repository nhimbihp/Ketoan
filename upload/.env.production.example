APP_NAME="Thu Chi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://thuchi.ten-mien-cua-ban.vn

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Tạo trong cPanel > MySQL Databases (tên có tiền tố tài khoản cPanel, vd cpuser_thuchi)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_thuchi
DB_USERNAME=cpuser_thuchi
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Gửi email quên mật khẩu (cPanel > Email Accounts)
MAIL_MAILER=smtp
MAIL_HOST=mail.ten-mien-cua-ban.vn
MAIL_PORT=465
MAIL_USERNAME=no-reply@ten-mien-cua-ban.vn
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@ten-mien-cua-ban.vn"
MAIL_FROM_NAME="${APP_NAME}"
